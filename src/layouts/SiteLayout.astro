---
interface Props {
	title: string;
}

const { title } = Astro.props;
const navigation = [
	{ label: 'Home', href: '/' },
	{ label: 'Over ons', href: '/ons/' },
	{ label: 'Memoir ’44', href: '/over-memoir-44/' },
	{ label: 'Dutch Open', href: '/dutch-open/' },
	{ label: 'Kalender', href: '/kalender/' },
	{ label: 'Foto’s', href: '/fotos/' },
	{ label: 'Documenten', href: '/documenten/' },
	{ label: 'Contact', href: '/contact/' },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="De Memoir ’44 Brigade Nederland: speeldagen, toernooien en informatie over Memoir ’44."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title === 'M44Brigade' ? title : `${title} | M44Brigade`}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Ga naar de inhoud</a>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href="/" aria-label="M44Brigade home">
					<span class="brand-mark">M44</span>
					<span>
						<strong>M44Brigade</strong>
						<small>Nederlandse Memoir ’44 spelersgroep</small>
					</span>
				</a>
			</div>
		</header>
		<nav class="site-nav" aria-label="Hoofdnavigatie">
			<div class="nav-inner">
				{navigation.map((item) => (
					<a
						href={item.href}
						aria-current={currentPath === item.href ? 'page' : undefined}
					>
						{item.label}
					</a>
				))}
			</div>
		</nav>
		<div class="page-wrap">
			<div class="page-grid">
				<main id="main-content" class="main-panel">
					<slot />
				</main>
				<aside class="sidebar">
					<section class="widget">
						<h2>Over de Brigade</h2>
						<p>
							De Memoir ’44 Brigade Nederland brengt spelers samen voor
							speeldagen, demonstraties en toernooien.
						</p>
						<a href="/ons/">Meer over ons <span aria-hidden="true">→</span></a>
					</section>
					<section class="widget">
						<h2>Op deze website</h2>
						<ul>
							<li><a href="/dutch-open/">Memoir ’44 Dutch Open</a></li>
							<li><a href="/kalender/">Speeldagen en kalender</a></li>
							<li><a href="/documenten/">Spelregels en documenten</a></li>
							<li><a href="/fotos/">Foto’s van toernooien</a></li>
						</ul>
					</section>
					<p class="sidebar-note">Voor liefhebbers van geschiedenis en Memoir ’44.</p>
				</aside>
			</div>
		</div>
		<footer class="site-footer">
			<div class="footer-inner">
				<span>M44Brigade</span>
				<span>Nederlandse Memoir ’44 spelersgroep</span>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		font-family: Arial, Helvetica, sans-serif;
		color: #333;
		background: #eeece8;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		--accent: #725639;
		--charcoal: #333;
		--paper: #fff;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-width: 320px;
		line-height: 1.65;
	}

	a {
		color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	a:hover {
		color: #4a3522;
	}

	.skip-link {
		position: absolute;
		top: -4rem;
		left: 1rem;
		z-index: 10;
		padding: 0.6rem 1rem;
		background: white;
	}

	.skip-link:focus {
		top: 1rem;
	}

	.site-header {
		background: var(--paper);
		border-bottom: 1px solid #dedbd6;
	}

	.header-inner,
	.nav-inner,
	.page-wrap,
	.footer-inner {
		width: min(1120px, calc(100% - 2rem));
		margin-inline: auto;
	}

	.header-inner {
		min-height: 112px;
		display: flex;
		align-items: center;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		color: var(--charcoal);
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 58px;
		height: 58px;
		place-items: center;
		border: 3px solid var(--accent);
		color: var(--accent);
		font-size: 1.25rem;
		font-weight: 800;
		letter-spacing: -0.08em;
	}

	.brand strong {
		display: block;
		font-size: 1.8rem;
		letter-spacing: -0.045em;
		line-height: 1.2;
	}

	.brand small {
		color: #6a6865;
		font-size: 0.9rem;
	}

	.site-nav {
		background: var(--charcoal);
	}

	.nav-inner {
		display: flex;
		flex-wrap: wrap;
	}

	.site-nav a {
		padding: 0.75rem 1rem;
		color: #f7f5f2;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.site-nav a:hover,
	.site-nav a[aria-current="page"] {
		background: var(--accent);
	}

	.page-wrap {
		padding-block: 2rem 3rem;
	}

	.page-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 270px;
		gap: 1.5rem;
		align-items: start;
	}

	.main-panel {
		min-width: 0;
		padding: clamp(1.25rem, 3vw, 2.25rem);
		border-top: 5px solid var(--accent);
		background: var(--paper);
		box-shadow: 0 2px 8px #332b2310;
	}

	.sidebar {
		display: grid;
		gap: 1rem;
	}

	.widget {
		padding: 1.25rem;
		background: var(--paper);
		box-shadow: 0 2px 8px #332b2310;
	}

	.widget h2 {
		margin: -1.25rem -1.25rem 1rem;
		padding: 0.65rem 1.25rem;
		background: var(--charcoal);
		color: white;
		font-size: 1rem;
		line-height: 1.4;
	}

	.widget p {
		margin-top: 0;
	}

	.widget ul {
		margin: 0;
		padding-left: 1.2rem;
	}

	.widget li + li {
		margin-top: 0.35rem;
	}

	.sidebar-note {
		margin: 0;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--accent);
		color: #5c5955;
		font-size: 0.9rem;
	}

	.site-footer {
		background: var(--charcoal);
		color: #ddd9d3;
		font-size: 0.85rem;
	}

	.footer-inner {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.25rem;
	}

	.recovered-content > :first-child,
	.saved-photos > :first-child {
		margin-top: 0;
	}

	.recovered-content h2,
	.saved-photos h2 {
		margin: 0 0 1.1rem;
		padding-bottom: 0.5rem;
		border-bottom: 4px solid var(--charcoal);
		color: #333;
		font-size: clamp(1.45rem, 2.5vw, 1.9rem);
		line-height: 1.3;
	}

	.recovered-content h3 {
		margin-top: 1.7rem;
		font-size: 1.2rem;
		line-height: 1.4;
	}

	.recovered-content p {
		margin: 0 0 1rem;
	}

	.recovered-content img {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1rem auto;
	}

	.recovered-content iframe {
		display: block;
		max-width: 100%;
		margin: 1rem auto;
		border: 0;
	}

	.recovered-content table {
		display: block;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}

	.recovered-content th,
	.recovered-content td {
		padding: 0.4rem 0.65rem;
		border: 1px solid #d8d3cd;
		text-align: left;
	}

	.recovered-content li + li {
		margin-top: 0.35rem;
	}

	.recovery-notice {
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--accent);
		background: #f5f1ec;
	}

	.recovery-notice p {
		margin: 0;
	}

	.saved-photos {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid #dedbd6;
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
		gap: 0.75rem;
	}

	.photo-grid a {
		display: block;
		overflow: hidden;
		background: #eee;
	}

	.photo-grid img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform 160ms ease;
	}

	.photo-grid a:hover img {
		transform: scale(1.04);
	}

	@media (max-width: 760px) {
		.page-grid {
			grid-template-columns: 1fr;
		}

		.sidebar {
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		}
	}

	@media (max-width: 520px) {
		.header-inner,
		.nav-inner,
		.page-wrap,
		.footer-inner {
			width: min(100% - 1rem, 1120px);
		}

		.header-inner {
			min-height: 94px;
		}

		.brand-mark {
			width: 48px;
			height: 48px;
		}

		.brand strong {
			font-size: 1.5rem;
		}

		.brand small {
			font-size: 0.8rem;
		}

		.site-nav a {
			padding: 0.6rem 0.7rem;
			font-size: 0.82rem;
		}

		.page-wrap {
			padding-block: 1rem 2rem;
		}

		.main-panel {
			padding: 1rem;
		}

		.footer-inner {
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>

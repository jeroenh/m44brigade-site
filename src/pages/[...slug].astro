---
import SiteLayout from '../layouts/SiteLayout.astro';
import RecoveredContent from '../components/RecoveredContent.astro';
import pages from '../data/recovered-pages.json';

export function getStaticPaths() {
	return pages
		.filter((page) => page.slug !== '')
		.map((page) => ({
			params: { slug: page.slug },
			props: { page },
		}));
}

const { page } = Astro.props;
---

<SiteLayout title={page.title}>
	<RecoveredContent page={page} />
</SiteLayout>

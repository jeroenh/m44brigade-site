---
import SiteLayout from '../layouts/SiteLayout.astro';
import RecoveredContent from '../components/RecoveredContent.astro';
import pages from '../data/recovered-pages.json';

const page = pages.find((item) => item.slug === '');
if (!page) throw new Error('Recovered home page content is missing.');
---

<SiteLayout title="M44Brigade">
	<RecoveredContent page={page} />
</SiteLayout>
